{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["DOM", "ESNext"],
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "./",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "maps/**/*.json"],
  "exclude": ["node_modules", "dist"]
}
